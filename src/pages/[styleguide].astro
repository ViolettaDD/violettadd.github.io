---
/*
 * Guía de estilo interna en /_styleguide (noindex, fuera del sitemap).
 * Astro ignora archivos de src/pages que empiezan con "_", por eso es una ruta dinámica.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Tag from '@/components/Tag.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Paper from '@/components/Paper.astro';
import Receipt from '@/components/Receipt.astro';
import MenuSection from '@/components/MenuSection.astro';
import TicketCard from '@/components/TicketCard.astro';
import AvailabilityBadge from '@/components/AvailabilityBadge.astro';
import Jukebox from '@/components/Jukebox.astro';
import MediaEmbed from '@/components/MediaEmbed.astro';
import ProjectNav from '@/components/ProjectNav.astro';
import CopyButton from '@/components/CopyButton.astro';
import Placeholder from '@/components/Placeholder.astro';
import tokensCss from '@/styles/tokens.css?raw';
import burger from '@/assets/illustrations/burger.png';
import { parseColorTokens, contrastRatio, contrastLevel } from '@/lib/contrast';
import { site } from '@/data/site';

export function getStaticPaths() {
  return [{ params: { styleguide: '_styleguide' } }];
}

const colors = parseColorTokens(tokensCss);
const hexColors = Object.entries(colors).filter(([, v]) => v.startsWith('#'));
const groups: { title: string; prefix: RegExp }[] = [
  { title: 'Marca', prefix: /^color-(violet|teal|brick|mustard|mauve|sage)/ },
  { title: 'Neutros y papel', prefix: /^color-(bone|cream|ink|white|chess)/ },
  { title: 'Madera y corcho', prefix: /^color-(wood|cork)/ },
  { title: 'Tickets', prefix: /^color-ticket/ },
  { title: 'Jukebox', prefix: /^color-(neon|curtain|brass|jukebox)/ },
  { title: 'Placeholders', prefix: /^color-placeholder/ },
];
const roles = Object.entries(colors).filter(([name]) =>
  /^color-(bg|text|text-muted|heading|link|link-hover|accent|border|surface-paper|surface-raised|focus|focus-on-dark)$/.test(name),
);

// Combinaciones texto/fondo usadas en el sitio. large = texto grande (≥24 px o ≥18,5 px bold): basta 3:1.
type Pair = { fg: string; bg: string; use: string; large?: boolean; nonText?: boolean };
const tickets = ['green', 'periwinkle', 'teal', 'salmon', 'sage', 'mustard'];
const pairs: Pair[] = [
  { fg: 'ink-900', bg: 'bone-50', use: 'Texto general' },
  { fg: 'ink-500', bg: 'bone-50', use: 'Texto secundario' },
  { fg: 'ink-900', bg: 'cream-200', use: 'Texto sobre papel' },
  { fg: 'ink-500', bg: 'cream-200', use: 'Secundario sobre papel' },
  { fg: 'violet-600', bg: 'bone-50', use: 'Enlaces' },
  { fg: 'violet-800', bg: 'bone-50', use: 'Enlace hover' },
  { fg: 'violet-600', bg: 'cream-200', use: 'Enlaces y títulos sobre papel' },
  { fg: 'teal-700', bg: 'bone-50', use: 'Acento' },
  { fg: 'teal-700', bg: 'cream-200', use: 'Subtítulo del recibo' },
  { fg: 'brick-700', bg: 'bone-50', use: 'Títulos del menú' },
  { fg: 'brick-700', bg: 'cream-200', use: 'Títulos del menú sobre papel' },
  { fg: 'white', bg: 'violet-600', use: 'Botón primario' },
  { fg: 'white', bg: 'teal-700', use: 'Botón "¡Copiado!"' },
  { fg: 'bone-50', bg: 'wood-900', use: 'Pie de página' },
  { fg: 'cream-200', bg: 'wood-900', use: 'Pie: texto secundario' },
  { fg: 'mustard-300', bg: 'wood-900', use: 'Pie: hover' },
  { fg: 'white', bg: 'ink-900', use: 'Letrero "We’re open"' },
  { fg: 'brass-300', bg: 'curtain-700', use: 'Título del jukebox', large: true },
  { fg: 'cream-200', bg: 'curtain-700', use: 'Texto del jukebox' },
  { fg: 'brass-300', bg: 'ink-900', use: 'Código de canción' },
  { fg: 'ink-900', bg: 'mustard-300', use: 'Canción seleccionada' },
  { fg: 'ink-900', bg: 'chess-light', use: 'Canciones' },
  ...tickets.map((c) => ({ fg: 'ink-900', bg: `ticket-${c}`, use: `Ticket ${c}` })),
  ...tickets.map((c) => ({ fg: 'brick-700', bg: `ticket-${c}`, use: `Año en ticket ${c}`, large: true })),
  { fg: 'violet-800', bg: 'violet-100', use: 'Tag Juegos' },
  { fg: 'teal-700', bg: 'teal-100', use: 'Tag Animación' },
  { fg: 'ink-900', bg: 'mustard-300', use: 'Tag Arte' },
  { fg: 'bone-50', bg: 'ink-700', use: 'Tag Código' },
  { fg: 'placeholder', bg: 'placeholder-bg', use: 'Placeholder' },
  { fg: 'placeholder', bg: 'placeholder-stripe', use: 'Placeholder (trama)' },
  { fg: 'white', bg: 'placeholder', use: 'Insignia [POR COMPLETAR]' },
  { fg: 'violet-600', bg: 'bone-50', use: 'Anillo de foco', nonText: true },
  { fg: 'mustard-300', bg: 'wood-900', use: 'Anillo de foco en oscuro', nonText: true },
  { fg: 'teal-500', bg: 'bone-50', use: 'Teal de marca (solo decorativo)', nonText: true },
];
const rows = pairs.map((p) => {
  const fg = colors[`color-${p.fg}`];
  const bg = colors[`color-${p.bg}`];
  const ratio = contrastRatio(fg, bg);
  const required = p.large || p.nonText ? 3 : 4.5;
  return { ...p, fgHex: fg, bgHex: bg, ratio, level: contrastLevel(ratio), pass: ratio >= required, required };
});
const failures = rows.filter((r) => !r.pass).length;

const steps = ['-2', '-1', '0', '1', '2', '3', '4', '5'];
const spaces = Array.from({ length: 10 }, (_, i) => i + 1);
const radii = ['sm', 'md', 'lg', 'pill'];
const shadows = ['hard-sm', 'hard-md', 'hard-lg', 'paper'];
const surfaces = [
  { cls: 'surface--paper', name: 'Papel', note: 'Tarjetas, recibo, menú, header' },
  { cls: 'surface--wood', name: 'Madera', note: 'Bandas y fondos de sección' },
  { cls: 'surface--wood-dark', name: 'Madera oscura', note: 'Pie de página' },
  { cls: 'surface--cork', name: 'Corcho', note: 'Tablero de proyectos' },
  { cls: 'surface--chess', name: 'Ajedrez', note: 'Bandas decorativas' },
  { cls: 'surface--chess-red', name: 'Ajedrez rojo', note: 'Fondo de Sobre mí' },
];
const fontCandidates = [
  { family: 'Vio Display', name: 'Alfa Slab One (actual)', file: 'alfa-slab-one-latin-400.woff2' },
  { family: 'Candidate Shrikhand', name: 'Shrikhand', file: 'shrikhand-latin-400.woff2' },
  { family: 'Candidate Bungee', name: 'Bungee', file: 'bungee-latin-400.woff2' },
];
const demoTracks = [
  {
    title: 'Demo con póster',
    note: 'Estado: listo',
    media: { type: 'youtube' as const, id: 'styleguide0', title: 'Video de demostración', poster: burger },
  },
  {
    title: 'Demo sin video',
    note: 'Estado: placeholder',
    media: { type: 'youtube' as const, id: '[POR COMPLETAR] ID', title: 'Pendiente' },
  },
  { title: 'Tercera canción', media: { type: 'youtube' as const, id: '[POR COMPLETAR] ID', title: 'Pendiente' } },
];
---

<BaseLayout title="Guía de estilo" description="Guía de estilo interna del sitio de Vio." noindex>
  <div class="sg container container--wide">
    <header class="sg__intro">
      <p class="label">Interno · noindex</p>
      <h1>Guía de estilo</h1>
      <p class="prose">
        Tokens, superficies y componentes del sitio. Todo lo que se ve aquí sale de
        <code>src/styles/tokens.css</code> y <code>src/components/</code>.
      </p>
      <nav aria-label="Secciones de la guía">
        <ul class="sg__toc cluster" role="list">
          <li><a href="#color">Color</a></li>
          <li><a href="#contraste">Contraste</a></li>
          <li><a href="#tipografia">Tipografía</a></li>
          <li><a href="#espacio">Espacio y forma</a></li>
          <li><a href="#superficies">Superficies</a></li>
          <li><a href="#componentes">Componentes</a></li>
          <li><a href="#placeholders">Placeholders</a></li>
        </ul>
      </nav>
    </header>

    {/* COLOR */}
    <section class="sg__section" id="color" aria-labelledby="color-title">
      <SectionHeading title="Color" id="color-title" eyebrow="Tokens" />
      {
        groups.map((group) => (
          <div class="sg__group">
            <h3 class="sg__h3">{group.title}</h3>
            <ul class="sg__swatches" role="list">
              {hexColors
                .filter(([name]) => group.prefix.test(name))
                .map(([name, value]) => (
                  <li class="sg__swatch">
                    <span class="sg__chip" style={`background: var(--${name})`} />
                    <code>--{name}</code>
                    <span class="text-muted">{value}</span>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
      <div class="sg__group">
        <h3 class="sg__h3">Roles semánticos (usar en componentes)</h3>
        <ul class="sg__swatches" role="list">
          {
            roles.map(([name, value]) => (
              <li class="sg__swatch">
                <span class="sg__chip" style={`background: var(--${name})`} />
                <code>--{name}</code>
                <span class="text-muted">{value}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* CONTRASTE */}
    <section class="sg__section" id="contraste" aria-labelledby="contrast-title">
      <SectionHeading title="Contraste WCAG" id="contrast-title" eyebrow="Accesibilidad">
        Calculado en el build a partir de tokens.css. Texto normal: 4.5:1. Texto grande y elementos
        no textuales: 3:1. {failures === 0 ? 'Todas las combinaciones pasan.' : `${failures} combinación(es) fallan.`}
      </SectionHeading>
      <div class="sg__table-wrap">
        <table class="sg__table">
          <caption class="visually-hidden">Contraste de combinaciones texto/fondo</caption>
          <thead>
            <tr>
              <th scope="col">Muestra</th>
              <th scope="col">Texto / fondo</th>
              <th scope="col">Uso</th>
              <th scope="col">Ratio</th>
              <th scope="col">Nivel</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <td>
                    <span class="sg__sample" style={`color: ${r.fgHex}; background: ${r.bgHex}`}>
                      Aa
                    </span>
                  </td>
                  <td>
                    <code>{r.fg}</code> / <code>{r.bg}</code>
                  </td>
                  <td>
                    {r.use}
                    {r.large && ' (texto grande)'}
                    {r.nonText && ' (no textual)'}
                  </td>
                  <td>{r.ratio.toFixed(2)}:1</td>
                  <td>
                    <span class:list={['sg__level', r.pass ? 'sg__level--pass' : 'sg__level--fail']}>
                      {r.pass ? '✓' : '✗'} {r.level}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {/* TIPOGRAFÍA */}
    <section class="sg__section" id="tipografia" aria-labelledby="type-title">
      <SectionHeading title="Tipografía" id="type-title" eyebrow="Tokens">
        --font-display solo para logo, títulos y etiquetas. --font-body para todo texto de lectura.
      </SectionHeading>

      <h3 class="sg__h3">Candidatas para títulos (licencia OFL)</h3>
      <p class="prose">
        Elige una y cambia la línea <code>src</code> del <code>@font-face</code> de "Vio Display" en tokens.css.
        Licencias en <code>docs/FONTS.md</code>.
      </p>
      <div class="sg__fonts">
        {
          fontCandidates.map((f) => (
            <article class="sg__font" style={`--sample-font: '${f.family}'`}>
              <p class="label">{f.name}</p>
              <p class="sg__font-hero">Vio Diner</p>
              <p class="sg__font-h">Proyectos · Sobre mí · Contacto</p>
              <p class="sg__font-small">PLUSH HOUR 2024 · ¿Jugamos? ¡Ñandú!</p>
              <code>public/fonts/{f.file}</code>
            </article>
          ))
        }
      </div>

      <h3 class="sg__h3">Escala fluida (320 → 1440 px)</h3>
      <ul class="sg__scale" role="list">
        {
          steps.map((s) => (
            <li>
              <code>--step-{s}</code>
              <span style={`font-size: var(--step-${s}); font-family: ${Number(s) >= 1 ? 'var(--font-display)' : 'var(--font-body)'}`}>
                Diseño de videojuegos
              </span>
            </li>
          ))
        }
      </ul>

      <h3 class="sg__h3">Texto de lectura</h3>
      <div class="prose">
        <p>
          Párrafo de muestra en Atkinson Hyperlegible Next, a <code>--step-0</code> con interlineado 1.6 y un ancho
          máximo de <code>--measure</code> (68ch). Así se verán los estudios de caso y la sección Sobre mí. Un
          <a href="#tipografia">enlace dentro del texto</a> usa el violeta de marca.
        </p>
        <ul>
          <li>Lista con viñetas en violeta</li>
          <li>Segundo elemento de la lista</li>
        </ul>
      </div>
    </section>

    {/* ESPACIO Y FORMA */}
    <section class="sg__section" id="espacio" aria-labelledby="space-title">
      <SectionHeading title="Espacio y forma" id="space-title" eyebrow="Tokens" />
      <div class="sg__grid-2">
        <div>
          <h3 class="sg__h3">Espaciado (4/8 px)</h3>
          <ul class="sg__spaces" role="list">
            {
              spaces.map((n) => (
                <li>
                  <code>--space-{n}</code>
                  <span class="sg__bar" style={`width: var(--space-${n})`} />
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="sg__h3">Radios</h3>
          <ul class="sg__boxes" role="list">
            {
              radii.map((r) => (
                <li>
                  <span class="sg__box" style={`border-radius: var(--radius-${r})`} />
                  <code>--radius-{r}</code>
                </li>
              ))
            }
          </ul>
          <h3 class="sg__h3">Sombras</h3>
          <ul class="sg__boxes" role="list">
            {
              shadows.map((s) => (
                <li>
                  <span class="sg__box sg__box--light" style={`box-shadow: var(--shadow-${s})`} />
                  <code>--shadow-{s}</code>
                </li>
              ))
            }
          </ul>
          <h3 class="sg__h3">Breakpoints, capas y movimiento</h3>
          <ul class="sg__list">
            <li><code>--bp-sm</code> 36em · <code>--bp-md</code> 48em · <code>--bp-lg</code> 64em · <code>--bp-xl</code> 80em</li>
            <li><code>--z-raised</code> 10 · <code>--z-sticky</code> 100 · <code>--z-overlay</code> 200 · <code>--z-skip-link</code> 1000</li>
            <li><code>--duration-fast</code> 120ms · <code>--duration-base</code> 200ms · <code>--duration-slow</code> 320ms (0 con reduced motion)</li>
            <li><code>--tap-min</code> 44px: alto mínimo de botones y enlaces de navegación</li>
          </ul>
        </div>
      </div>
    </section>

    {/* SUPERFICIES */}
    <section class="sg__section" id="superficies" aria-labelledby="surfaces-title">
      <SectionHeading title="Superficies" id="surfaces-title" eyebrow="surfaces.css">
        Texturas CSS/SVG sin imágenes. Nunca texto directo sobre corcho o ajedrez.
      </SectionHeading>
      <ul class="sg__surfaces" role="list">
        {
          surfaces.map((s) => (
            <li>
              <span class:list={['sg__surface', s.cls]} />
              <code>.{s.cls}</code>
              <span class="text-muted">{s.name}: {s.note}</span>
            </li>
          ))
        }
      </ul>
      <h3 class="sg__h3">Bandas y bordes</h3>
      <div class="sg__bands">
        <div class="stripe-band"></div>
        <code>.stripe-band</code>
        <div class="chess-band"></div>
        <code>.chess-band</code>
        <div class="sg__torn surface--paper edge-torn-both"></div>
        <code>.edge-torn-both</code> / <code>.edge-torn-bottom</code>
      </div>
    </section>

    {/* COMPONENTES */}
    <section class="sg__section" id="componentes" aria-labelledby="components-title">
      <SectionHeading title="Componentes" id="components-title" eyebrow="src/components" />

      <div class="sg__component">
        <h3 class="sg__h3">Button</h3>
        <div class="cluster">
          <Button href="#componentes">Primario</Button>
          <Button href="#componentes" variant="secondary">Secundario</Button>
          <Button href="#componentes" variant="link" icon="arrow">Enlace</Button>
          <Button size="sm" icon="download">Pequeño con icono</Button>
          <Button variant="secondary" icon="play">Botón</Button>
          <Button href="https://astro.build" external variant="link">Externo</Button>
        </div>
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">Tag</h3>
        <div class="cluster">
          <Tag variant="discipline" tone="games">Juegos</Tag>
          <Tag variant="discipline" tone="animation">Animación</Tag>
          <Tag variant="discipline" tone="art">Arte</Tag>
          <Tag variant="discipline" tone="code">Código</Tag>
          <Tag variant="status" tone="complete">Completo</Tag>
          <Tag variant="status" tone="in-progress">En desarrollo</Tag>
          <Tag>Unity</Tag>
          <Tag>After Effects</Tag>
        </div>
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">SectionHeading</h3>
        <SectionHeading title="Proyectos destacados" level={3} eyebrow="Antetítulo">
          Introducción opcional de la sección.
          <Button slot="actions" href="#componentes" variant="link" icon="arrow">Ver todos</Button>
        </SectionHeading>
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">TicketCard</h3>
        <div class="sg__tickets">
          <TicketCard
            title="Con portada"
            href="#componentes"
            year={2024}
            type="Segunda línea del ticket"
            disciplines={['games', 'code']}
            cover={burger}
            coverAlt=""
            color="green"
            index={0}
          />
          <TicketCard
            title="Sin portada"
            href="#componentes"
            year={2023}
            type="Muestra el placeholder 16:10"
            disciplines={['animation']}
            color="periwinkle"
            index={1}
            coverSource="frontmatter → cover"
          />
          <TicketCard title="Color salmón" href="#componentes" year={2025} disciplines={['art']} color="salmon" index={2} />
        </div>
      </div>

      <div class="sg__component sg__grid-2">
        <div>
          <h3 class="sg__h3">AvailabilityBadge</h3>
          <div class="cluster sg__signs">
            <AvailabilityBadge />
            <AvailabilityBadge status="closed" size="sm" showMessage={false} />
          </div>
        </div>
        <div>
          <h3 class="sg__h3">Paper</h3>
          <Paper tilt={-1}>
            <p>Superficie de papel con bordes rasgados. Acepta <code>edges</code>, <code>tilt</code> y <code>padding</code>.</p>
          </Paper>
        </div>
      </div>

      <div class="sg__component sg__grid-2">
        <div>
          <h3 class="sg__h3">Receipt</h3>
          <Receipt title="Recibo" subtitle="Subtítulo impreso" number="0042">
            <p>Filas del recibo (slot por defecto).</p>
            <hr />
            <p class="cluster">
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <CopyButton value={site.email} label="Copiar correo" />
            </p>
            <p slot="footer">Pie del recibo (slot "footer").</p>
          </Receipt>
        </div>
        <div>
          <h3 class="sg__h3">MenuSection</h3>
          <Paper>
            <MenuSection
              title="Especialidades"
              level={3}
              subtitle="Subtítulo opcional"
              items={[
                { name: 'Plato con detalle', detail: '2024', note: 'Nota secundaria' },
                { name: 'Plato con enlace', detail: 'Ver', href: '#componentes' },
                { name: 'Plato sin detalle' },
              ]}
            >
              <p>Contenido libre antes de la lista.</p>
            </MenuSection>
          </Paper>
        </div>
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">MediaEmbed</h3>
        <div class="sg__grid-2">
          <div>
            <p class="label">Facade (póster + play). ID ficticio de demostración.</p>
            <MediaEmbed media={{ type: 'youtube', id: 'styleguide0', title: 'Demostración', poster: burger }} />
          </div>
          <div>
            <p class="label">Pendiente</p>
            <MediaEmbed pendingLabel="Video principal del proyecto" pendingSource="frontmatter → media" />
          </div>
          <div>
            <p class="label">Imagen</p>
            <MediaEmbed media={{ type: 'image', src: burger, alt: 'Hamburguesa vista desde arriba' }} ratio="4/3" />
          </div>
        </div>
      </div>

      <div class="sg__component sg__component--wood surface--wood on-dark">
        <h3 class="sg__h3">Jukebox</h3>
        <Jukebox tracks={demoTracks} heading="Showreel" headingLevel={3} headingId="sg-jukebox" />
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">ProjectNav</h3>
        <ProjectNav prev={{ title: 'Proyecto anterior', href: '#componentes' }} next={{ title: 'Proyecto siguiente', href: '#componentes' }} />
      </div>

      <div class="sg__component">
        <h3 class="sg__h3">Header, Footer y SkipLink</h3>
        <p>Están en esta misma página: el header arriba, el pie abajo. El skip link aparece al pulsar Tab al cargar.</p>
      </div>
    </section>

    {/* PLACEHOLDERS */}
    <section class="sg__section" id="placeholders" aria-labelledby="ph-title">
      <SectionHeading title="Placeholders" id="ph-title" eyebrow="Contenido pendiente">
        Se ocultan con PUBLIC_SHOW_PLACEHOLDERS=false. El deploy falla si quedan en el HTML.
      </SectionHeading>
      <div class="sg__ph-grid">
        <Placeholder kind="image" label="Imagen" format="1600×900 px, WebP/JPG ≤ 300 KB" source="archivo → campo" ratio="16/9" />
        <Placeholder kind="video" label="Video" format="YouTube: solo el ID" source="frontmatter → media" />
        <Placeholder kind="embed" label="Juego HTML5 de itch.io" format="URL del iframe" source="frontmatter → media" ratio="16/10" />
        <Placeholder kind="text" label="Párrafo" format="2–4 frases" source="archivo.mdx → sección" lines={4} />
        <Placeholder kind="list" label="Lista" format="3–5 elementos" source="src/data/about.ts" items={4} />
        <Placeholder kind="gallery" label="Galería del proceso" format="4–8 imágenes 4:3" source="archivo.mdx → Proceso" items={4} />
        <Placeholder kind="link" label="Enlace a itch.io" format="URL completa" source="frontmatter → links.play" size="compact" />
