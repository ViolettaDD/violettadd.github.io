---
/**
 * Seo: <title>, description, canonical, Open Graph, Twitter Card y JSON-LD.
 * Props:
 * - title?: string         título de la página (sin el nombre; se agrega solo). Omitir en el inicio.
 * - description?: string   150–160 caracteres; por defecto site.description
 * - image?: string         ruta absoluta de la imagen OG (1200×630); por defecto /og/default.png
 * - imageAlt?: string
 * - type?: 'website' | 'article' | 'profile'
 * - noindex?: boolean      true para páginas internas (/_styleguide, 404)
 * - jsonLd?: object | object[]  datos estructurados
 */
import { site } from '@/data/site';
import { t } from '@/i18n';
import { isPending } from '@/lib/placeholders';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = '/og/default.png',
  imageAlt = site.name,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const sep = t.meta.titleSeparator;
const homeTitle = isPending(site.role) ? site.name : `${site.name}${sep}${site.role}`;
const fullTitle = title ? `${title}${sep}${site.name}` : homeTitle;

// Canonical siempre con barra final (así lo sirve GitHub Pages con build.format = 'directory')
const path = Astro.url.pathname.replace(/\/?$/, '/').replace(/\/index\.html\/$/, '/');
const canonical = new URL(path, Astro.site ?? site.url).href;
const imageUrl = new URL(image, Astro.site ?? site.url).href;
const ldItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={`${site.shortName} — ${site.name}`} />
<meta property="og:locale" content={t.meta.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#fae0ab" />

{ldItems.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}
