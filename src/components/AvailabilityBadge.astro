---
/**
 * AvailabilityBadge: letrero colgante "We're open" (CSS, texto real) + mensaje de disponibilidad.
 * Lee estado, texto y mensaje de src/data/site.ts → availability (un solo lugar).
 * Props:
 * - status?: 'open' | 'closed'   fuerza un estado (por defecto, el de site.ts)
 * - size?: 'lg' | 'sm'           (por defecto 'lg')
 * - showMessage?: boolean        muestra el mensaje bajo el letrero (por defecto true)
 * - signText?: string            reemplaza el texto del letrero (p. ej. en la 404)
 * - class?: string
 */
import Placeholder from './Placeholder.astro';
import { site, type AvailabilityStatus } from '@/data/site';
import { isPending } from '@/lib/placeholders';
import { t } from '@/i18n';

interface Props {
  status?: AvailabilityStatus;
  size?: 'lg' | 'sm';
  showMessage?: boolean;
  signText?: string;
  class?: string;
}

const {
  status = site.availability.status,
  size = 'lg',
  showMessage = true,
  signText,
  class: className,
} = Astro.props;

const text = signText ?? site.availability.sign[status];
const message = site.availability.message;
---

<div class:list={['avail', `avail--${status}`, `avail--${size}`, className]}>
  <div class="avail__sign">
    <span class="avail__hanger" aria-hidden="true"></span>
    <p class="avail__board">
      <span class="visually-hidden">{t.availability.label}: </span>
      <span class="avail__text" lang="en">{text}</span>
    </p>
  </div>
  {
    showMessage &&
      (isPending(message) ? (
        <Placeholder
          kind="text"
          size="compact"
          label="Mensaje de disponibilidad (1 línea)"
          source="src/data/site.ts → availability.message"
          class="avail__message"
        />
      ) : (
        <p class="avail__message">{message}</p>
      ))
  }
</div>

<style>
  .avail {
    display: inline-grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: 100%;
  }

  .avail__sign {
    --sign-pad: 0.6rem;
    position: relative;
    display: grid;
    justify-items: center;
    padding-block-start: 2.75rem;
    transform-origin: 50% 0.4rem;
    transform: rotate(var(--sign-tilt, -2deg));
    transition: transform var(--duration-slow) var(--ease-spring);
  }

  .avail__sign:hover {
    transform: rotate(var(--sign-tilt-hover, 1.5deg));
  }

  /* Cordel y clavo */
  .avail__hanger {
    position: absolute;
    top: 0;
    left: 50%;
    width: 7rem;
    height: 2.9rem;
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 50% 0.45rem, var(--color-ink-500) 0 0.4rem, var(--color-ink-900) 0.42rem 0.5rem, transparent 0.52rem),
      linear-gradient(to top right, transparent calc(50% - 2px), var(--color-wood-900) calc(50% - 2px) calc(50% + 2px), transparent calc(50% + 2px)) left / 50% 100% no-repeat,
      linear-gradient(to top left, transparent calc(50% - 2px), var(--color-wood-900) calc(50% - 2px) calc(50% + 2px), transparent calc(50% + 2px)) right / 50% 100% no-repeat;
  }

  .avail__board {
    position: relative;
    padding: var(--sign-pad);
    background: var(--pattern-brand-stripes);
    --stripe-width: 1.75rem;
    border: var(--border-thick) solid var(--color-ink-900);
    box-shadow: var(--shadow-hard-md);
  }

  .avail__text {
    display: block;
    padding: var(--space-3) var(--space-5);
    background: var(--color-ink-900);
    border: var(--border-thin) solid var(--color-sage-500);
    outline: 4px solid var(--color-ink-900);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: center;
    text-wrap: balance;
  }

  .avail--sm .avail__sign {
    padding-block-start: 2rem;
    --sign-pad: 0.4rem;
  }

  .avail--sm .avail__hanger {
    width: 5rem;
    height: 2.1rem;
  }

  .avail--sm .avail__text {
    padding: var(--space-2) var(--space-4);
    font-size: var(--step-1);
  }

  .avail--closed .avail__sign {
    --sign-tilt: 6deg;
    --sign-tilt-hover: 3deg;
  }

  .avail--closed .avail__board {
    background: repeating-linear-gradient(90deg, var(--color-ink-500) 0 1.75rem, var(--color-wood-700) 1.75rem 3.5rem);
  }

  .avail--closed .avail__text {
    color: var(--color-cream-200);
  }

  .avail__message {
    max-width: 36ch;
    font-size: var(--step-0);
    text-align: center;
  }
</style>
