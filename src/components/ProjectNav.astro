---
/**
 * ProjectNav: navegación anterior / siguiente al final de un estudio de caso.
 * Props:
 * - prev?: { title: string; href: string }
 * - next?: { title: string; href: string }
 * - class?: string
 * Siempre incluye un enlace de vuelta al índice de proyectos.
 */
import { t } from '@/i18n';

interface NavTarget {
  title: string;
  href: string;
}

interface Props {
  prev?: NavTarget;
  next?: NavTarget;
  class?: string;
}

const { prev, next, class: className } = Astro.props;
---

<nav class:list={['project-nav', className]} aria-label={t.caseStudy.projectNav}>
  <ul class="project-nav__list" role="list">
    <li class="project-nav__item project-nav__item--prev">
      {
        prev && (
          <a class="project-nav__link" href={prev.href} rel="prev">
            <span class="project-nav__dir label">
              <span aria-hidden="true">←</span> {t.caseStudy.prev}
            </span>
            <span class="project-nav__title">{prev.title}</span>
          </a>
        )
      }
    </li>
    <li class="project-nav__item project-nav__item--index">
      <a class="project-nav__back" href="/proyectos/">{t.actions.backToProjects}</a>
    </li>
    <li class="project-nav__item project-nav__item--next">
      {
        next && (
          <a class="project-nav__link" href={next.href} rel="next">
            <span class="project-nav__dir label">
              {t.caseStudy.next} <span aria-hidden="true">→</span>
            </span>
            <span class="project-nav__title">{next.title}</span>
          </a>
        )
      }
    </li>
  </ul>
</nav>

<style>
  .project-nav__list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .project-nav__list {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .project-nav__item--next {
      text-align: end;
    }

    .project-nav__item--index {
      order: 0;
    }
  }

  .project-nav__item:empty {
    display: none;
  }

  @media (min-width: 48em) {
    .project-nav__item:empty {
      display: block;
    }
  }

  .project-nav__link {
    display: grid;
    gap: var(--space-1);
    min-height: var(--tap-min);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface-raised);
    border: var(--border-ink);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard-md);
    color: var(--color-ink-900);
    text-decoration: none;
    transition:
      transform var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .project-nav__link:hover {
    color: var(--color-ink-900);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow-color);
  }

  .project-nav__dir {
    color: var(--color-violet-600);
  }

  .project-nav__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: var(--leading-tight);
  }

  .project-nav__back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding-inline: var(--space-3);
    font-weight: var(--weight-bold);
  }
</style>
